# Optional future approved backend. Leave unset to use the five matched demo titles.
# Configure before building; rebuild when changing the catalog source.
FLURZI_CATALOG_API_URL=
# Optional server-side credential; never use NEXT_PUBLIC_ for this value.
FLURZI_CATALOG_API_TOKEN=
# Production deployment origin, once confirmed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opt-in local streaming-app demo. Leave unset for production (services fail closed).
# Development server: NEXT_PUBLIC_USE_MOCKS=1.
# Optimized preview builds additionally require NEXT_PUBLIC_FLURZI_CHANNEL=preview.
# Release builds must leave BOTH variables unset; never deploy preview artifacts as releases.
NEXT_PUBLIC_USE_MOCKS=

NEXT_PUBLIC_FLURZI_CHANNEL=
